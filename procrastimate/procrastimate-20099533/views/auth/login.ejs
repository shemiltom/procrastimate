<%- include('../partials/head') %>
<div class="signin">
  <aside class="signin-aside">
    <span class="brand">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 7h11a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H3z"/><path d="M16 10.5 21 8v8l-5-2.5"/></svg>
      </span>
      <span>Procrastimate<span class="brand-sub">AV equipment desk</span></span>
    </span>
    <div class="signin-pitch">
      <h1>Equipment booking and dispatch</h1>
      <p>Reserve cameras, microphones and projectors, check stock before you promise a date, and collect with the paperwork ready.</p>
    </div>
    <p class="signin-meta">Audiovisual store · Staff workspace</p>
  </aside>

  <main class="signin-main">
    <div class="signin-card">
      <h2>Sign in</h2>
      <p class="lead">Use your store account.</p>

      <% if (message) { %>
        <p class="notice" role="status"><%= message %></p>
      <% } %>

      <form method="post" action="/login">
        <div class="field">
          <label for="username">Username</label>
          <input id="username" name="username" type="text" autocomplete="username"
                 maxlength="200" required value="<%= username %>">
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password"
                 maxlength="200" required>
        </div>
        <button class="button" type="submit">Sign in</button>
      </form>

      <p class="hint">Forgotten your password? Ask a coordinator to reset it.</p>
    </div>
  </main>
</div>
<%- include('../partials/foot') %>
